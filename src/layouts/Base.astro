---
// src/layouts/Base.astro
import '../styles/global.css';
import TocMenu from '../components/TocMenu.astro';
import { SITE, type Locale } from '../i18n/site';

interface Props {
  title: string; description?: string; locale: Locale; altHref: string; footerHref?: string; footerLabel?: string; footerNote?: string;
  /** 不让搜索引擎收录（404 页） */
  noindex?: boolean;
  /** 语言切换里“当前语言”那一项的链接；默认是本页地址。404 页的地址随访问路径变，所以要指定 */
  selfHref?: string;
}
const { title, description = '', locale, altHref, footerHref, footerLabel, footerNote, noindex = false, selfHref } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = `${base}${locale}/`;
const self = selfHref ?? Astro.url.pathname;
const zhHref = locale === 'zh' ? self : altHref;
const enHref = locale === 'en' ? self : altHref;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {SITE[locale].name}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="alternate" hreflang={locale === 'zh' ? 'en' : 'zh'} href={altHref} />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@700;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <a class="site-logo" href={home} aria-label={`${SITE[locale].name}`}>
          <span class="dot"></span><span class="name">{SITE[locale].name}</span>
        </a>
        <nav class="lang-switch" aria-label={locale === 'zh' ? '语言' : 'Language'}>
          <a href={zhHref} lang="zh" aria-current={locale === 'zh' ? 'true' : 'false'}>中</a>
          <a href={enHref} lang="en" aria-current={locale === 'en' ? 'true' : 'false'}>EN</a>
        </nav>
        <TocMenu locale={locale} />
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <span>{footerNote ?? SITE[locale].footer}</span>
        <a href={footerHref ?? `${base}${locale}/casino/`}>{footerLabel ?? SITE[locale].casino}</a>
      </footer>
    </div>
  </body>
</html>
