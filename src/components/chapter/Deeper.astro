---
/** “想深究？”折叠块（设计稿里的 <details>）。内容放在 slot 里。 */
interface Props { summary: string }
const { summary } = Astro.props;
---
<details class="ch-deeper">
  <summary>{summary}<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></summary>
  <div class="ch-deeper-body"><slot /></div>
</details>
