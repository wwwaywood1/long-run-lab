---
// src/components/TocMenu.astro
/**
 * 页眉右侧的“目录”按钮：点开显示章节目录，数据与首页目录同源（i18n/toc.ts）。
 * 纯 Astro + 一小段原生脚本；没有 JavaScript 时按钮不起作用，面板保持 hidden。
 */
import common from '../../i18n/source/common.json';
import { pageText } from '../i18n/page';
import { tocEntries } from '../i18n/toc';
import type { Locale } from '../i18n/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { t } = pageText(common, locale);
const label = t('common.028');
const entries = tocEntries(locale);

// 当前页加粗：忽略结尾斜杠的差异（trailingSlash: 'always' 时两者通常已经一致）
const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);
---
<div class="toc-menu">
  <button
    type="button"
    id="toc-button"
    class="toc-button"
    aria-label={label}
    aria-expanded="false"
    aria-controls="toc-panel"
  >
    <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M3 7h14M3 13h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  </button>
  <nav id="toc-panel" class="toc-panel" hidden aria-label={label}>
    <div class="toc-list">
      {entries.map((entry) => (
        <a
          class="toc-row"
          href={entry.href}
          aria-current={normalize(entry.href) === current ? 'page' : undefined}
        >
          <span class="toc-tag">{entry.tag}</span>
          <span class="toc-title">{entry.label}</span>
        </a>
      ))}
    </div>
  </nav>
</div>

<script>
  const button = document.getElementById('toc-button');
  const panel = document.getElementById('toc-panel');

  if (button && panel) {
    const isOpen = () => button.getAttribute('aria-expanded') === 'true';

    const close = (refocus = false) => {
      panel.hidden = true;
      button.setAttribute('aria-expanded', 'false');
      if (refocus) button.focus();
    };

    const open = () => {
      panel.hidden = false;
      button.setAttribute('aria-expanded', 'true');
      panel.querySelector('a')?.focus();
    };

    button.addEventListener('click', () => {
      if (isOpen()) close(true);
      else open();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) close(true);
    });

    document.addEventListener('click', (event) => {
      if (!isOpen()) return;
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (panel.contains(target) || button.contains(target)) return;
      close();
    });
  }
</script>

<style>
  /* 页眉右侧：语言切换紧贴目录按钮，目录按钮落在最右；面板以页眉为定位基准。 */
  :global(.site-header) { position: relative; }
  :global(.site-header .lang-switch) { margin-left: auto; }

  .toc-button {
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toc-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 10;
    max-height: calc(100vh - 64px);
    overflow-y: auto;
    padding: 8px var(--gutter) 16px;
    background: var(--page);
    border-bottom: 1px solid var(--rule);
  }
  .toc-panel[hidden] { display: none; }

  .toc-list { display: flex; flex-direction: column; border-top: 1px solid var(--rule); }
  .toc-row { min-height: 64px; display: flex; align-items: center; gap: 16px; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .toc-tag { flex: none; width: 28px; font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  :global(html[lang='en']) .toc-tag { width: 64px; }
  .toc-title { font-family: var(--font-display); font-size: 19px; font-weight: 700; color: var(--ink); }
  .toc-row[aria-current='page'] .toc-title { font-weight: 900; }
</style>
