---
import Base from '../../../layouts/Base.astro';
import Blackjack, { BlackjackBustGrid } from '../../../components/Blackjack';
import DarkReveal from '../../../components/shared/DarkReveal';
import { highlightCopy } from '../../../i18n/copy';
import { SITE, money } from '../../../i18n/site';
import numbers from '../../../../data/numbers.json';
import source from '../../../../i18n/source/Blackjack.json';
import '../../../components/Blackjack.css';
const locale = 'zh' as const;
const base = import.meta.env.BASE_URL;
const c = (id: number) => source.strings.find(entry => entry.id === `Blackjack.${String(id).padStart(3, '0')}`)!.zh;
// Original design figures remain distinct from the existing seeded edge estimate.
// See presentation_reference.note and docs/prs/G5_BLACKJACK_PR.md for provenance limits.
const reference = numbers.blackjack.presentation_reference.value;
const counts = reference.counting;
const percent = (value: number, digits = 1) => new Intl.NumberFormat('en-US', { style: 'percent', minimumFractionDigits: digits, maximumFractionDigits: digits }).format(value);
const strategyRows = [
  { label: c(27), note: c(28), edge: reference.strategy_edges.basic_3to2 },
  { label: c(29), note: c(30), edge: reference.strategy_edges.basic_6to5 },
  { label: c(31), note: c(32), edge: reference.strategy_edges.mimic },
  { label: c(33), note: c(34), edge: reference.strategy_edges.never },
];
---
<Base title={c(1)} locale={locale} altHref={`${base}en/casino/blackjack/`} description={c(3)} footerHref={`${base}${locale}/research/ville/`} footerLabel={SITE[locale].research}>
  <section class="hero"><div class="eyebrow">{c(2)}</div><h1 class="display">{c(1)}</h1><p class="lede">{c(3)}</p></section>
  <section class="section" aria-label={c(4)}><Blackjack client:visible locale={locale} /></section>
  <DarkReveal labelledBy="zero-h" className="bj-reveal">
    <h2 id="zero-h" set:html={c(20)} />
    <BlackjackBustGrid sample={reference.bust_sample} playerBusts={reference.player_busts} bothBusts={reference.both_busts} label={c(20).replaceAll('<br>', ' ')} />
    <div class="bj-bust-legend"><span><i></i>{c(21)}</span><span><i></i>{c(22)}</span></div>
    <div style="display:flex;flex-direction:column;gap:8px"><div class="bj-fraction"><span class="big">{reference.both_busts}</span><span class="bj-mono">{c(23)}</span></div><p class="bj-emphasis" set:html={c(24)} /></div>
    <p class="bj-explanation">{c(25)}</p>
  </DarkReveal>
  <section class="bj-strategies" aria-labelledby="strategy-h">
    <h2 id="strategy-h" set:html={c(26)} />
    <div class="bj-strategy-bars">{strategyRows.map((row, i) => <div class:list={['bj-strategy-bar', { loss: i > 0 }]}>
      <div class="bj-row"><strong>{row.label}</strong><span class="bj-mono">{percent(row.edge)}</span></div>
      <div class="bj-track"><i style={{ width: `${row.edge / reference.strategy_edges.never * 100}%` }}></i></div>
      <span class="shared-note">{row.note}</span>
    </div>)}</div>
    <p class="sources">{c(35)}</p>
  </section>
  <section class="bj-counting" aria-labelledby="count-h">
    <h2 id="count-h">{c(36)}</h2><p class="bj-explanation">{c(37)}</p>
    <div class="bj-hilo-key"><div><span class="bj-mono">2–6</span><strong>+1</strong></div><div><span class="bj-mono">7–9</span><strong>0</strong></div><div><span class="bj-mono">10–A</span><strong>−1</strong></div></div>
    <p class="bj-explanation">{c(38)}</p>
    <div class="bj-count-facts">
      <p>{c(39)}</p>
      <div class="bj-row"><span>{c(40)}</span><strong class="edge">+{percent(counts.player_edge, 2)}</strong></div>
      <div class="bj-row"><span>{c(41)}</span><span class="bj-mono">{money(counts.hourly_win, locale, false)}</span></div>
      <div class="bj-row"><span>{c(43)}</span><span class="bj-mono">±{money(counts.hourly_swing, locale, false)}</span></div>
      <div class="divider"></div>
      <span>{c(45)}</span><strong class="hours">{c(46)}</strong><p>{c(47)}</p>
    </div>
    <div class="bj-countermeasures"><strong>{c(48)}</strong>{[49, 50, 51].map((id, i) => <div><span class="bj-mono">{String(i + 1).padStart(2, '0')}</span><span>{c(id)}</span></div>)}</div>
    <p class="bj-emphasis" set:html={highlightCopy(c(52), '输得最慢')} />
    <p class="sources">{c(53)}</p>
  </section>
  <a class="next-link" href={`${base}${locale}/casino/lottery/`}><span class="eyebrow">{c(54)}</span><span class="title">{c(55)}</span></a>
</Base>
