---
import DarkReveal from '../../../components/shared/DarkReveal';
import { highlightCopy } from '../../../i18n/copy';
import Base from '../../../layouts/Base.astro';
import Baccarat from '../../../components/Baccarat';
import numbers from '../../../../data/numbers.json';
import source from '../../../../i18n/source/Baccarat.json';
import '../../../components/Baccarat.css';
const locale = 'en' as const;
const base = import.meta.env.BASE_URL;
const c = (id: number) => {
  const entry = source.strings.find(s => s.id === `Baccarat.${String(id).padStart(3, '0')}`)!;
  return entry.en || entry.zh;
};
const { prob, edge } = numbers.baccarat.eight_deck_published.value;
const sides = ['B', 'P', 'T'] as const;
const names = { B: c(22), P: c(23), T: c(24) };
const labels = { B: c(30), P: c(31), T: c(32) };
const percentFormat = new Intl.NumberFormat('en-US', { style: 'percent', minimumFractionDigits: 2, maximumFractionDigits: 2 });
const percent = (value: number) => percentFormat.format(value).replace('%', '');
---
<Base title={c(1)} locale={locale} altHref={`${base}zh/casino/baccarat/`} description={c(3)}>
  <section class="hero">
    <div class="eyebrow">{c(2)}</div>
    <h1 class="display">{c(1)}</h1>
    <p class="lede">{c(3)}</p>
  </section>
  <section class="section" aria-label={c(4)}>
    <Baccarat client:visible locale={locale} />
  </section>
  <DarkReveal className="bc-reveal" labelledBy="road-h">
    <h2 id="road-h" set:html={c(20)} />
    <div class="bc-streak" aria-hidden="true">
      {['P', 'B', 'B', 'B', 'B', 'B', 'B', 'B', '?'].map(s => <span>{s === '?' ? '?' : s}</span>)}
    </div>
    <p class="bc-legend">B = {names.B} · P = {names.P} · T = {names.T}</p>
    <p class="bc-emphasis" set:html={c(21)} />
    <div class="bc-probs">
      {sides.map(s => <div class="bc-prob"><strong>{names[s]}</strong><div class="bc-prob-bar" style={{ width: `${prob[s] / prob.B * 100}%` }}></div><span class="bc-mono">{percent(prob[s])}%</span></div>)}
    </div>
    <p class="bc-emphasis bc-same" set:html={highlightCopy(c(25), 'Exactly')} />
    <p class="bc-explanation">{c(26)}</p>
    <p class="sources">{c(27)}</p>
  </DarkReveal>
  <section class="bc-vig" aria-labelledby="vig-h">
    <h2 id="vig-h" set:html={c(28)} />
    <p class="bc-explanation">{c(29)}</p>
    <div class="bc-edges">
      {sides.map(s => <div class:list={['bc-edge', { loss: s === 'T' }]}>
        <div class="bc-row"><strong>{labels[s]}</strong><span class="bc-mono">{percent(edge[s])}%</span></div>
        <div class="bc-edge-track"><span style={{ width: `${edge[s] / edge.T * 100}%` }}></span></div>
      </div>)}
    </div>
    <p class="bc-emphasis" set:html={c(33)} />
    <p class="sources">{c(34)}</p>
  </section>
  <a class="next-link" href={`${base}${locale}/casino/slots/`}>
    <span class="eyebrow">{c(35)}</span><span class="title">{c(36)}</span>
  </a>
</Base>
