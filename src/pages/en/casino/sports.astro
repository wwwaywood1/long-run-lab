---
import { pageHref } from '../../../i18n/routes';
import Base from '../../../layouts/Base.astro';
import Sports from '../../../components/Sports';
import DarkReveal from '../../../components/shared/DarkReveal';
import { highlightCopy } from '../../../i18n/copy';
import { money } from '../../../i18n/site';
import numbers from '../../../../data/numbers.json';
import source from '../../../../i18n/source/Sports.json';
import '../../../components/Sports.css';
const locale = 'en' as const;
const base = import.meta.env.BASE_URL;
const c = (id: number) => source.strings.find(entry => entry.id === `Sports.${String(id).padStart(3, '0')}`)![locale];
const stats = numbers.sports, presentation = stats.presentation.value, june = numbers.facts.china_lottery_jun_2026;
const allocation = numbers.lottery.presentation_reference.value.welfare_allocation;
const percent = (p: number) => new Intl.NumberFormat('en-US', { style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(p);
const total = stats.example_overround.value;
const probabilities = presentation.example_implied_probabilities;
const returnRows = Object.entries(presentation.return_per_100).map(([legs, value], index) => ({ legs: Number(legs), value, label: c(43 + index), share: stats.return_by_legs.value[legs as keyof typeof stats.return_by_legs.value] }));
const highlight = "the most tempting";
---
<Base title={c(1)} locale={locale} altHref={`${base}zh/casino/sports/`} description={c(3)} footerHref={`${base}${locale}/ending/`} footerLabel={c(61)}>
  <section class="hero"><div class="eyebrow">{c(2)}</div><h1 class="display">{c(1)}</h1><p class="lede">{c(3)}</p></section>
  <section class="sp-welfare" aria-labelledby="welfare-h"><div class="sp-welfare-card">
    <div class="sp-welfare-label"><strong>{c(4)}</strong><span>{c(5)}</span></div>
    <h2 id="welfare-h">{c(6)}</h2><p class="sp-muted">{c(7)}</p>
    <div class="sp-welfare-fact"><strong>{c(8)}</strong><span>{c(9)}</span></div>
    <div class="sp-split"><div class="sp-split-bar" aria-hidden="true">{allocation.map(share => <i style={{ width: `${share * 100}%` }} />)}</div><div class="sp-split-key">{[10, 11, 12, 13].map(id => <span><i />{c(id)}</span>)}</div></div>
    <div class="sp-responsible"><strong>{c(14)}</strong>{[15, 16, 17].map((id, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><span>{c(id)}</span></div>)}</div>
    <p class="sources">{c(18)}</p>
  </div></section>
  <section class="section" aria-label={c(19)}><Sports client:visible locale={locale} /></section>
  <DarkReveal labelledBy="vig-h" className="sp-vig">
    <h2 id="vig-h" set:html={c(33)} />
    <div class="sp-odds-example">{presentation.example_odds.map((odds, index) => <div><span>{c(34 + index)}</span><strong>{odds.toFixed(2)}</strong><span>→ {percent(probabilities[index])}</span></div>)}</div>
    <svg class="sp-overround" viewBox="0 0 342 64" role="img" aria-label={c(37)}>
      {probabilities.map((probability, index) => <rect x={probabilities.slice(0, index).reduce((sum, value) => sum + value, 0) / total * 342} y="16" width={probability / total * 342} height="28" fill={['#fff', 'var(--soft-on-dark)', 'var(--muted-on-dark)'][index]} />)}
      <rect x={342 / total} y="16" width={presentation.example_vig / total * 342} height="28" fill="var(--highlight)" />
      <line x1={342 / total} y1="6" x2={342 / total} y2="54" stroke="var(--highlight)" stroke-width="2" />
      <text x={342 / total - 4} y="62" text-anchor="end" font-family="var(--font-mono)" font-size="11" fill="var(--highlight)">100%</text>
      <text x="0" y="11" font-family="var(--font-mono)" font-size="11" fill="var(--muted-on-dark)">{c(38)}</text>
      <text x="342" y="11" text-anchor="end" font-family="var(--font-mono)" font-size="11" fill="var(--highlight)">{percent(total)}</text>
    </svg>
    <div style="display:flex;flex-direction:column;gap:8px"><span class="big">{percent(presentation.example_vig)}</span><p class="sp-statement" set:html={c(39)} /></div>
    <p class="sp-muted">{c(40)}</p>
  </DarkReveal>
  <section class="sp-parlay" aria-labelledby="parlay-h"><h2 id="parlay-h" set:html={c(41)} />
    <div class="sp-return-chart"><span>{c(42)}</span>{returnRows.map(row => <div class="sp-return-row"><strong>{row.label}</strong><div class="sp-return-track" aria-hidden="true"><i style={{ width: `${row.share * 100}%` }} /></div><span>{money(row.value, locale, false)}</span></div>)}</div>
    <p class="sp-statement" set:html={highlightCopy(c(49), highlight)} /><p class="sp-muted">{c(50)}</p>
  </section>
  <section class="sp-skill" aria-labelledby="skill-h"><h2 id="skill-h">{c(51)}</h2><p class="sp-body">{c(52)}</p><p class="sp-body">{c(53)}</p>
    <div class="sp-growth"><strong>+{percent(june.yoy)}</strong><span>{c(54)}</span></div>
    <div class="sp-illegal">{c(55)} <a href={pageHref(locale, 'Part2-Scam')}>{c(56)}</a>{c(57)}</div>
    <p class="sources">{c(58)}</p>
  </section>
  <a class="next-link" href={`${base}${locale}/casino/`}><span class="eyebrow">{c(59)}</span><span class="title">{c(60)}</span></a>
</Base>

