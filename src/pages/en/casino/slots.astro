---
import { highlightCopy } from '../../../i18n/copy';
import Base from '../../../layouts/Base.astro';
import Slots, { SlotsOutcomeGrid } from '../../../components/Slots';
import DarkReveal from '../../../components/shared/DarkReveal';
import { THREE_KIND, CHERRY_PAY } from '../../../engine/slots';
import numbers from '../../../../data/numbers.json';
import source from '../../../../i18n/source/Slots.json';
import '../../../components/Slots.css';
const locale = 'en' as const;
const base = import.meta.env.BASE_URL;
const c = (id: number) => {
  const entry = source.strings.find(s => s.id === `Slots.${String(id).padStart(3, '0')}`)!;
  return entry.en || entry.zh;
};
const stats = numbers.slots;
const counts = stats.hundred_outcomes.value;
const grid = Object.entries(counts).flatMap(([kind, count]) => Array.from({ length: count }, () => kind));
const percent = (value: number, digits = 2) => new Intl.NumberFormat('en-US', { style: 'percent', minimumFractionDigits: digits, maximumFractionDigits: digits }).format(value);
const oneInJackpot = Math.round(1 / stats.p_777.value);
const rows = [
  { key: '777', label: '7 · 7 · 7', pay: THREE_KIND['777'] },
  { key: 'BBB', label: 'BAR · BAR · BAR', pay: THREE_KIND.BBB },
  { key: 'SSS', label: '★ · ★ · ★', pay: THREE_KIND.SSS },
  { key: 'DDD', label: '◆ · ◆ · ◆', pay: THREE_KIND.DDD },
  { key: 'CCC', label: `${c(30)} <span class="sl-dot">●</span>`, pay: CHERRY_PAY[3] },
  { key: 'CC', label: `${c(31)} <span class="sl-dot">●</span>`, pay: CHERRY_PAY[2] },
  { key: 'C', label: `${c(32)} <span class="sl-dot">●</span> <small>${c(33)}</small>`, pay: CHERRY_PAY[1] },
] as const;
---
<Base title={c(1)} locale={locale} altHref={`${base}zh/casino/slots/`} description={c(3)}>
  <section class="hero"><div class="eyebrow">{c(2)}</div><h1 class="display">{c(1)}</h1><p class="lede">{c(3)}</p></section>
  <section class="section" aria-label={c(4)}><Slots client:visible locale={locale} /></section>
  <DarkReveal labelledBy="ldw-h" className="sl-reveal">
    <h2 id="ldw-h" set:html={c(17)} />
    <SlotsOutcomeGrid items={grid} label={c(17).replace('<br>', '')} />
    <div class="sl-counts"><span><i class="win"></i>{c(18)}</span><span><i class="ldw"></i>{c(19)}</span><span><i></i>{c(20)}</span></div>
    <div style="display:flex;flex-direction:column;gap:8px"><span class="big">{counts.ldw}</span><p class="sl-emphasis" set:html={c(21)} /></div>
    <p class="sl-explanation">{c(22)}</p>
  </DarkReveal>
  <section class="sl-near" aria-labelledby="near-h">
    <h2 id="near-h" set:html={c(23)} />
    <div class="sl-near-examples">
      <div class="sl-near-example"><div class="sl-row"><strong class="sl-near-symbols">7 · 7 · 7</strong><span class="sl-mono">1 / {oneInJackpot}</span></div><p>{c(24)}</p></div>
      <div class="sl-near-example"><div class="sl-row"><strong class="sl-near-symbols">7 · 7 · <span>?</span></strong><span class="sl-mono loss">{c(25)}</span></div><p>{c(26)}</p></div>
    </div>
    <p class="sl-mechanism" set:html={highlightCopy(c(27), '19 times')} /><p class="sl-explanation">{c(28)}</p>
  </section>
  <section class="sl-pay" aria-labelledby="pay-h">
    <h2 id="pay-h">{c(29)}</h2>
    <div class="sl-pay-table">{rows.map(row => <div class:list={['sl-pay-row', { ldw: row.key === 'C' }]}>
      <span set:html={row.label} /><span class="sl-mono">{row.pay}×</span><span class="sl-mono sl-prob">{percent(stats.pay_table_probabilities.value[row.key])}</span>
    </div>)}</div>
    <div class="sl-summary">
      <div class="sl-row"><span>{c(34)}</span><span class="sl-mono">{percent(stats.rtp.value, 1)}</span></div>
      <div class="sl-row"><span>{c(35)}</span><strong class="sl-minute">{percent(stats.edge.value, 1)}</strong></div>
      <div class="sl-row sl-fact"><span>{c(36)}</span><span class="sl-mono">{percent(numbers.facts.nevada_sep_2025.strip_slots_hold.value[1], 1)}</span></div>
    </div>
    <p>{c(37)}</p>
  </section>
  <a class="next-link" href={`${base}${locale}/casino/crash/`}><span class="eyebrow">{c(38)}</span><span class="title">{c(39)}</span></a>
</Base>
