---
// src/views/Part2Scam.astro
/**
 * 第二部分 · 网赌与杀猪盘。设计稿 preview/Part2-Scam.dc.html，文案 i18n/source/Part2-Scam.json。
 * 一个模板同时出中英文：文字一律 t()，站内链接一律 pageHref()。
 * 求助/举报渠道不照抄设计稿号码：中文读 helplines.regions.cn.fraud，英文依次读 us.fraud + uk.fraud。
 */
import Chapter from '../components/chapter/Chapter.astro';
import Hero from '../components/chapter/Hero.astro';
import Step from '../components/chapter/Step.astro';
import NextChapter from '../components/chapter/NextChapter.astro';
import Predict from '../components/chapter/Predict';
import source from '../../i18n/source/Part2-Scam.json';
import helplines from '../../data/helplines.json';
import { pageText } from '../i18n/page';
import { pageHref } from '../i18n/routes';
import type { Locale } from '../i18n/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { t } = pageText(source, locale);

interface Localized { zh: string; en: string }
interface FraudRow { name: Localized; detail?: Localized; contact?: string | Localized | null }

const fraudRows = (locale === 'zh'
  ? helplines.regions.cn.fraud
  : [...helplines.regions.us.fraud, ...helplines.regions.uk.fraud]) as FraudRow[];

const local = (v: string | Localized | null | undefined): string =>
  typeof v === 'string' ? v : v ? v[locale] : '';

// t(26)–t(28) 把列表序号 1/2/3 写进了文案开头；为照设计稿的序号列，渲染时拆到单独的序号 span。
const steps = [t(26), t(27), t(28)].map((text) => {
  const match = text.match(/^(\d+)\s*([\s\S]*)$/);
  return { n: match?.[1] ?? '', text: match?.[2] ?? text };
});
---
<Chapter locale={locale} page="Part2-Scam" title={t(1)} description={t(10)}>
  <nav class="p2s-nav" aria-label={t(2)}>
    <a href={pageHref(locale, 'Part2-Roulette')}>{t(3)}</a>
    <a href="#">{t(4)}</a>
    <a href="#">{t(5)}</a>
    <a href={pageHref(locale, 'Part2-Scam')} aria-current="page">{t(6)}</a>
    <a href="#">{t(7)}</a>
  </nav>

  <Hero eyebrow={t(8)} title={t(9)} lede={t(10)} />

  <Step id="s1" n="01" verb={t('common.029')} heading={t(11)}>
    <Predict client:visible locale={locale} label={t('common.030')} options={[t(12), t(13), t(14)]} answer={1} />
  </Step>

  <Step id="s2" n="02" verb={t('common.031')} heading={t(15)}>
    <svg viewBox="0 0 318 170" class="ch-figure" role="img" aria-label={t(16)}>
<rect x="133.8" y="8" width="176.2" height="144" fill="var(--ink-deep)" fill-opacity="0.05"/>
<line x1="133.8" y1="8" x2="133.8" y2="152" stroke="#9AA0AA" stroke-width="1" stroke-dasharray="3 3"/>
<text x={locale === 'en' ? 310 : 139} y="20" text-anchor={locale === 'en' ? 'end' : 'start'} font-family="var(--font-body)" font-size="11" fill="var(--muted)">{t(17)}</text>
<line x1="8" y1="65.6" x2="310" y2="65.6" stroke="#9AA0AA" stroke-width="1" stroke-dasharray="4 4"/>
<path d="M8.0 65.6 L10.5 63.2 L13.0 65.6 L15.6 68.0 L18.1 65.6 L20.6 63.2 L23.1 60.8 L25.6 63.2 L28.1 65.6 L30.6 63.2 L33.2 60.8 L35.7 63.2 L38.2 60.8 L40.7 63.2 L43.2 60.8 L45.8 58.4 L48.3 60.8 L50.8 58.4 L53.3 60.8 L55.8 63.2 L58.3 60.8 L60.8 58.4 L63.4 56.0 L65.9 58.4 L68.4 56.0 L70.9 53.6 L73.4 51.2 L76.0 48.8 L78.5 46.4 L81.0 44.0 L83.5 41.6 L86.0 39.2 L88.5 36.8 L91.1 34.4 L93.6 32.0 L96.1 29.6 L98.6 27.2 L101.1 29.6 L103.6 27.2 L106.2 29.6 L108.7 27.2 L111.2 29.6 L113.7 32.0 L116.2 29.6 L118.7 27.2 L121.2 29.6 L123.8 32.0 L126.3 34.4 L128.8 32.0 L131.3 34.4 L133.8 36.8 L136.3 39.2 L138.9 41.6 L141.4 44.0 L143.9 46.4 L146.4 48.8 L148.9 51.2 L151.4 48.8 L154.0 46.4 L156.5 48.8 L159.0 51.2 L161.5 48.8 L164.0 51.2 L166.6 53.6 L169.1 56.0 L171.6 58.4 L174.1 60.8 L176.6 63.2 L179.1 65.6 L181.6 68.0 L184.2 70.4 L186.7 72.8 L189.2 70.4 L191.7 68.0 L194.2 70.4 L196.8 72.8 L199.3 75.2 L201.8 77.6 L204.3 75.2 L206.8 77.6 L209.3 80.0 L211.9 82.4 L214.4 84.8 L216.9 87.2 L219.4 84.8 L221.9 87.2 L224.4 89.6 L226.9 92.0 L229.5 94.4 L232.0 96.8 L234.5 99.2 L237.0 101.6 L239.5 99.2 L242.1 101.6 L244.6 104.0 L247.1 106.4 L249.6 108.8 L252.1 111.2 L254.6 113.6 L257.1 116.0 L259.7 118.4 L262.2 116.0 L264.7 118.4 L267.2 120.8 L269.7 118.4 L272.2 120.8 L274.8 123.2 L277.3 125.6 L279.8 128.0 L282.3 130.4 L284.8 132.8 L287.4 135.2 L289.9 137.6 L292.4 135.2 L294.9 132.8 L297.4 130.4 L299.9 132.8 L302.4 135.2 L305.0 137.6 L307.5 140.0 L310.0 142.4" fill="none" stroke="var(--you)" stroke-width="2.4" stroke-linejoin="round"/>
<line x1="186.7" y1="8" x2="186.7" y2="152" stroke="var(--ink-deep)" stroke-width="1.2"/>
<circle cx="186.7" cy="72.8" r="10" fill="var(--highlight)"/>
<circle cx="186.7" cy="72.8" r="4.5" fill="var(--ink-deep)"/>
<text x="192" y="40" font-family="var(--font-body)" font-size="11" font-weight="700" fill="var(--ink)">{t(18)}</text>
<text x="192" y="54" font-family="var(--font-mono)" font-size="11" fill="var(--ink)">{t(19)}</text>
<text x="306" y="158" text-anchor="end" font-family="var(--font-mono)" font-size="11" font-weight="600" fill="var(--loss)">−3,200</text>
<text x="8" y="168" font-family="var(--font-mono)" font-size="11" fill="var(--muted)">{t(20)}</text>
<text x="133.8" y="168" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--muted)">50</text>
</svg>
    <div class="p2s-evidence">
      <span class="p2s-evidence-label">{t(21)}</span>
      <svg viewBox="0 0 318 60" class="ch-figure" role="img" aria-label={t(22)}>
<line x1="8" y1="12.7" x2="310" y2="12.7" stroke="var(--ink-deep)" stroke-width="1" stroke-dasharray="4 3"/>
<line x1="133.8" y1="4" x2="133.8" y2="56" stroke="#9AA0AA" stroke-width="1" stroke-dasharray="3 3"/>
<path d="M10.5 50.8 L13.0 45.2 L15.6 43.0 L18.1 46.5 L20.6 49.9 L23.1 50.8 L25.6 45.2 L28.1 43.0 L30.6 46.5 L33.2 49.9 L35.7 45.2 L38.2 48.6 L40.7 45.2 L43.2 48.6 L45.8 50.8 L48.3 45.2 L50.8 48.6 L53.3 45.2 L55.8 43.0 L58.3 46.5 L60.8 49.9 L63.4 50.8 L65.9 45.2 L68.4 48.6 L70.9 50.8 L73.4 50.8 L76.0 50.8 L78.5 50.8 L81.0 50.8 L83.5 50.8 L86.0 50.8 L88.5 50.8 L91.1 50.8 L93.6 50.8 L96.1 50.8 L98.6 50.8 L101.1 45.2 L103.6 48.6 L106.2 45.2 L108.7 48.6 L111.2 45.2 L113.7 43.0 L116.2 46.5 L118.7 49.9 L121.2 45.2 L123.8 43.0 L126.3 40.9 L128.8 44.3 L131.3 42.2 L133.8 40.0 L136.3 37.9 L138.9 35.7 L141.4 33.6 L143.9 31.5 L146.4 29.3 L148.9 27.2 L151.4 30.6 L154.0 34.0 L156.5 31.9 L159.0 29.7 L161.5 33.2 L164.0 31.0 L166.6 28.9 L169.1 26.7 L171.6 24.6 L174.1 22.4 L176.6 20.3 L179.1 18.2 L181.6 16.0 L184.2 13.9 L186.7 11.7" fill="none" stroke="var(--ink-deep)" stroke-width="1.8" stroke-linejoin="round"/>
<circle cx="186.7" cy="11.7" r="3.5" fill="var(--ink-deep)"/>
</svg>
    </div>
    <p class="ch-body">{t(23)}</p>
    <p class="ch-small">{t(24)}</p>
  </Step>

  <Step id="s3" n="03" verb={t('common.032')} heading={t(25)}>
    <ol class="p2s-steps">
      {steps.map((step) => (
        <li>
          <span class="p2s-step-n">{step.n}</span>
          <span>{step.text}</span>
        </li>
      ))}
    </ol>
    <a class="p2s-research" href={pageHref(locale, 'Research-Ville')}>{t(29)}</a>
  </Step>

  <Step id="rev" heading={t(30)} dark>
    <span class="p2s-stop">{t(31)}</span>
    <p class="p2s-stop-copy">{t(32)}</p>
  </Step>

  <Step id="s4" n="04" verb={t(33)} label={t(33)} afterDark>
    <div class="p2s-help">
      {fraudRows.map((row) => (
        <div class="p2s-help-row">
          <div class="p2s-help-main">
            <span class="p2s-help-name">{row.name[locale]}</span>
            {row.detail && <span class="p2s-help-detail">{row.detail[locale]}</span>}
          </div>
          <span class="p2s-help-contact">{local(row.contact)}</span>
        </div>
      ))}
    </div>
    <p class="ch-body">{t(38)}</p>
  </Step>

  <div class="p2s-next">
    <NextChapter href={pageHref(locale, 'Part3-Psych')} label={t(39)} title={t(40)} />
  </div>
</Chapter>

<style>
/* 机制导航：设计稿横向排、超出裁切；改成可横向滚动，避免英文标签被切掉 */
.p2s-nav { display: flex; gap: 22px; padding: 8px 0 0 var(--gutter); overflow-x: auto; white-space: nowrap; scrollbar-width: none; }
.p2s-nav::-webkit-scrollbar { display: none; }
.p2s-nav a { flex: none; min-height: 44px; display: flex; align-items: center; color: var(--muted); text-decoration: none; font-size: 15px; }
.p2s-nav a[aria-current='page'] { color: var(--ink); font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 8px; }

/* 检测器的证据值小图 */
.p2s-evidence { display: flex; flex-direction: column; gap: 6px; }
.p2s-evidence-label { font-size: 14px; line-height: 1.6; color: var(--muted); }

/* 检测器在做什么：1 / 2 / 3 */
.p2s-steps { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; border-top: 1px solid var(--rule); }
.p2s-steps li { padding: 18px 0; border-bottom: 1px solid var(--rule); display: flex; gap: 16px; }
.p2s-step-n { font-family: var(--font-mono); font-size: 13px; font-weight: 600; padding-top: 3px; }
.p2s-steps li > span:last-child { font-size: 17px; line-height: 1.7; }
.p2s-research { font-size: 15px; font-weight: 700; color: var(--ink); min-height: 44px; display: flex; align-items: center; }

/* 停手：128px 在 390px 屏上会顶到边，窄屏收一点 */
.p2s-stop { display: block; font-family: var(--font-display); font-size: clamp(80px, 28vw, 128px); font-weight: 900; line-height: 1; }
.p2s-stop-copy { margin: 0; font-size: 17px; line-height: 1.8; color: var(--soft-on-dark); }

/* 如果已经遇到了：数据来自 data/helplines.json */
.p2s-help { display: flex; flex-direction: column; border-top: 1px solid var(--rule); }
.p2s-help-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; padding: 12px 0; border-bottom: 1px solid var(--rule); }
.p2s-help-main { display: flex; flex-direction: column; gap: 2px; }
.p2s-help-name { font-size: 17px; font-weight: 700; }
.p2s-help-detail { font-size: 13px; line-height: 1.6; color: var(--muted); }
.p2s-help-contact { flex: none; max-width: 58%; text-align: right; font-family: var(--font-display); font-size: 20px; font-weight: 900; line-height: 1.3; overflow-wrap: anywhere; }

/* 下一节：设计稿上方一条细线 */
.p2s-next { border-top: 1px solid var(--rule); }
</style>
