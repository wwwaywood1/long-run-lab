---
// src/views/Ch4Martingale.astro
/**
 * 第 4 章 · 策略幻觉。设计稿 preview/Ch4-Martingale.dc.html，文案 i18n/source/Ch4-Martingale.json。
 * 一个模板同时出中英文：文字一律 t()，站内链接一律 pageHref()。
 * 第 02 段是 MartingaleLab（W4）；第 03 段的 98.88% / 1.12% / −4.32 由 engine/martingale 算出，测试核对与文案一致。
 */
import Chapter from '../components/chapter/Chapter.astro';
import Hero from '../components/chapter/Hero.astro';
import Step from '../components/chapter/Step.astro';
import Deeper from '../components/chapter/Deeper.astro';
import NextChapter from '../components/chapter/NextChapter.astro';
import Predict from '../components/chapter/Predict';
import MartingaleLab from '../components/widgets/MartingaleLab';
import { BUST, EV_PER_ROUND } from '../engine/martingale';
import source from '../../i18n/source/Ch4-Martingale.json';
import { pageText } from '../i18n/page';
import { pageHref } from '../i18n/routes';
import { money, type Locale } from '../i18n/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { t, rich } = pageText(source, locale);
/** 百分比保留 2 位小数：98.88%、1.12% */
const pct = (p: number) => `${(p * 100).toFixed(2)}%`;
---
<Chapter locale={locale} page="Ch4-Martingale" title={t(1)} description={t(4)}>
  <Hero eyebrow={t(2)} title={t(3)} lede={t(4)} />

  <Step id="s1" n="01" verb={t('common.029')} heading={t(5)}>
    <Predict client:visible locale={locale} label={t('common.030')} options={[t(6), t(7), t(8)]} answer={2} />
  </Step>

  <Step id="s2" n="02" verb={t('common.031')} heading={t(9)}>
    <MartingaleLab
      client:visible
      locale={locale}
      labels={{
        group: t(10),
        methods: { flat: t(11), double: t(12), stops: t(13), pattern: t(14) },
        params: t(15),
        storyChart: t(16),
        bankroll: t(17),
        storyPeak: t(18),
        storyCaption: t(21),
      }}
    />
  </Step>

  <Step id="s3" n="03" verb={t('common.032')} heading={t(22)} dark>
    <div class="p4m-pct-block">
      <span class="p4m-pct">{pct(1 - BUST)}</span>
      <span class="p4m-pct-copy">{t(23)}</span>
    </div>
    <div class="p4m-pct-block">
      <span class="p4m-pct loss">{pct(BUST)}</span>
      <span class="p4m-pct-copy">{t(24)}</span>
    </div>
    <div class="p4m-rule"></div>
    <div class="p4m-avg-block">
      <span class="p4m-avg-label">{t(25)}</span>
      <span class="p4m-avg loss">{money(EV_PER_ROUND, locale)}</span>
    </div>
    <p class="p4m-copy">{t(27)}</p>
  </Step>

  <Step id="ville" label={t(28)} afterDark>
    <div class="eyebrow">{t(28)}</div>
    <h2 id="ville-h" class="ch-statement" set:html={rich(29, {
      zh: '无论用什么方法，<br>把 1,000 元变成 10 万元的概率，<br>都不超过 <span class="p4m-mark">1%</span>。',
      en: 'Whatever method you use,<br>the chance of turning $1,000<br>into $100,000 is no more than <span class="p4m-mark">1%</span>.',
    })} />
    <p class="ch-body ch-muted">{t(30)}</p>
    <a class="p4m-proof" href={pageHref(locale, 'Research-Ville')}>{t(31)}</a>
  </Step>

  <Step id="s4" n="04" verb={t('common.033')} heading={t(32)}>
    <svg viewBox="0 0 318 150" class="ch-figure" role="img" aria-label={t(33)}>
<line x1="0" y1="34" x2="318" y2="34" stroke="var(--ink-deep)" stroke-width="1.2" stroke-dasharray="5 4"/>
<text x="0" y="26" font-family="var(--font-body)" font-size="11" font-weight="700" fill="var(--ink)">{t(34)}</text>
<g fill="var(--you)">
<rect x="4" y="118" width="30" height="14" rx="3"/>
<rect x="43" y="104" width="30" height="28" rx="3"/>
<rect x="82" y="90" width="30" height="42" rx="3"/>
<rect x="121" y="76" width="30" height="56" rx="3"/>
<rect x="160" y="62" width="30" height="70" rx="3"/>
<rect x="199" y="48" width="30" height="84" rx="3"/>
<rect x="238" y="34" width="30" height="98" rx="3"/>
</g>
<rect x="277" y="20" width="30" height="112" rx="3" fill="none" stroke="var(--loss)" stroke-width="1.5" stroke-dasharray="4 3"/>
<path d="M283 70 L301 88 M301 70 L283 88" stroke="var(--loss)" stroke-width="2" stroke-linecap="round"/>
<g font-family="var(--font-mono)" font-size="10.5" fill="var(--muted)" text-anchor="middle"><text x="19" y="146">10</text><text x="58" y="146">20</text><text x="97" y="146">40</text><text x="136" y="146">80</text><text x="175" y="146">160</text><text x="214" y="146">320</text><text x="253" y="146">640</text><text x="292" y="146" fill="var(--loss)" font-weight="600">1280</text></g>
</svg>
    <p class="ch-body">{t(35)}</p>
    <p class="ch-small">{t(36)}</p>
  </Step>

  <Deeper summary={t(37)}>
    <p>{t(38)}</p>
  </Deeper>

  <NextChapter href={pageHref(locale, 'Part2-Roulette')} label={t(39)} title={t(41)} />
</Chapter>

<style>

/* 每一轮拆开：98.88% / 1.12% / 每轮平均 −4.32 */
.p4m-pct-block { display: flex; flex-direction: column; gap: 6px; }
.p4m-pct { font-family: var(--font-display); font-size: 88px; font-weight: 900; line-height: 1; }
.p4m-pct-copy { font-size: 19px; line-height: 1.6; }
.p4m-rule { height: 1px; background: var(--line-on-dark); }
.p4m-avg-block { display: flex; flex-direction: column; gap: 8px; }
.p4m-avg-label { font-size: 17px; color: var(--soft-on-dark); }
.p4m-avg { font-family: var(--font-display); font-size: 64px; font-weight: 900; line-height: 1.1; }
.p4m-copy { margin: 0; font-size: 17px; line-height: 1.8; color: var(--soft-on-dark); }

/* 更强的结论：黄色底只给 1% */
:global(.p4m-mark) { background: var(--highlight); padding: 0 4px; }
.p4m-proof { min-height: 56px; border-radius: 999px; border: 1.5px solid var(--ink-deep); color: var(--ink); text-decoration: none; display: flex; align-items: center; justify-content: center; padding: 0 20px; font-size: 16px; font-weight: 700; }
</style>
