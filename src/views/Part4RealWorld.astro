---
// src/views/Part4RealWorld.astro
/**
 * 第四部分 · 真实世界的账本。设计稿 preview/Part4-RealWorld.dc.html，文案 i18n/source/Part4-RealWorld.json。
 */
import Chapter from '../components/chapter/Chapter.astro';
import Hero from '../components/chapter/Hero.astro';
import Step from '../components/chapter/Step.astro';
import Predict from '../components/chapter/Predict';
import NextChapter from '../components/chapter/NextChapter.astro';
import source from '../../i18n/source/Part4-RealWorld.json';
import { pageText } from '../i18n/page';
import { pageHref } from '../i18n/routes';
import type { Locale } from '../i18n/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { t } = pageText(source, locale);

// 三张小图：○ 2024 年 9 月（空心，右），● 2025 年 9 月（实心，左）。
const turns = [
  { label: t(27), change: '8.8% → 8.0%', from: 167.2, to: 152 },
  { label: t(28), change: '15.1% → 12.1%', from: 286.9, to: 229.9 },
  { label: t(29), change: '17.10% → 8.49%', from: 324.9, to: 161.3 },
];

const sources = [
  { name: t(33), state: t(34), used: true },
  { name: t(35), state: t(36), used: false },
  { name: t(37), state: t(36), used: false },
  { name: t(38), state: t(36), used: false },
];
---

<Chapter locale={locale} page="Part4-RealWorld" title={t(1)} description={t(4)}>
  <Hero eyebrow={t(2)} title={t(3)} lede={t(4)} />

  <Step id="s1" n="01" verb={t('common.029')} heading={t(5)}>
    <Predict client:visible locale={locale} label={t('common.030')} options={[t(6), t(7), t(8)]} answer={2} />
  </Step>

  <Step id="s2" n="02" verb={t('common.031')} heading={t(9)}>
    {/* WIDGET TurnoverLedger：滑块调“每个筹码平均被押几次”（1–30，默认 10），重算总下注额 = 筹码现金 × 次数、庄家赢走 = 总下注额 × 1.06%，再显示两个分母下的百分比；输入是滑块，输出是三条账目与两张卡片里的金额/百分比。 */}
    <div class="p4r-calc" data-widget="TurnoverLedger">
      <div class="p4r-slider">
        <div class="p4r-slider-head">
          <label for="p4r-turn">{t(10)}</label>
          <span class="p4r-slider-value">{t(11)}</span>
        </div>
        <input id="p4r-turn" type="range" min="1" max="30" value="10" />
      </div>

      <div class="p4r-ledger">
        <div class="p4r-row"><span>{t(12)}</span><span class="p4r-row-val">100</span></div>
        <div class="p4r-row"><span>{t(13)}</span><span class="p4r-row-val">1,000</span></div>
        <div class="p4r-row is-strong"><span>{t(14)}</span><span class="p4r-row-val">10.6</span></div>
      </div>

      <div class="p4r-cards">
        <div class="p4r-card">
          <span class="p4r-card-label">{t(15)}</span>
          <span class="p4r-card-value">1.06%</span>
          <span class="p4r-card-label">{t(16)}</span>
        </div>
        <div class="p4r-card is-dark">
          <span class="p4r-card-label">{t(17)}</span>
          <span class="p4r-card-value">10.6%</span>
          <span class="p4r-card-label">{t(18)}</span>
        </div>
      </div>
    </div>
    <p class="ch-small">{t(19)}</p>
  </Step>

  <Step id="s3" n="03" verb={t('common.032')} heading={t(20)} dark>
    <div class="p4r-big">
      <span class="p4r-big-value">$937.1M</span>
      <span class="p4r-big-label">{t(21)}</span>
    </div>
    <div class="p4r-big">
      <span class="p4r-big-value">$346.1M</span>
      <span class="p4r-big-label">{t(22)}</span>
    </div>
    <div class="p4r-rule"></div>
    <div class="p4r-months">
      <span class="p4r-months-num">55</span>
      <span class="p4r-months-unit">{t(23)}</span>
    </div>
    <p class="p4r-lead">{t(24)}</p>
    <p class="p4r-source">{t(25)}</p>
  </Step>

  <Step id="s3b" heading={t(26)} afterDark>
    <div class="p4r-changes">
      {turns.map((c) => (
        <div class="p4r-change">
          <div class="p4r-change-head">
            <span class="p4r-change-name">{c.label}</span>
            <span class="p4r-change-val">{c.change}</span>
          </div>
          <svg class="ch-figure" viewBox="0 0 342 20" aria-hidden="true">
            <line x1="0" y1="10" x2="342" y2="10" stroke="var(--rule)" stroke-width="2" />
            <line x1={Math.min(c.from, c.to)} y1="10" x2={Math.max(c.from, c.to)} y2="10" stroke="var(--ink-deep)" stroke-width="2" />
            <circle cx={c.from} cy="10" r="6" fill="var(--page)" stroke="var(--ink-deep)" stroke-width="2" />
            <circle cx={c.to} cy="10" r="6" fill="var(--ink-deep)" />
          </svg>
        </div>
      ))}
      <div class="p4r-axis">
        <span>0%</span>
        <span>{t(30)}</span>
        <span>18%</span>
      </div>
    </div>
    <p class="ch-body">{t(31)}</p>
  </Step>

  <Step id="s4" n="04" verb={t(32)} label={t(32)}>
    <div class="p4r-sources">
      {sources.map((s) => (
        <div class="p4r-source-row">
          <span>{s.name}</span>
          <span class:list={['p4r-source-state', !s.used && 'is-muted']}>{s.state}</span>
        </div>
      ))}
    </div>
  </Step>

  <div class="p4r-next">
    <NextChapter href={pageHref(locale, 'Ending')} label={t(39)} title={t(40)} />
  </div>
</Chapter>

<style>
  .p4r-calc { display: flex; flex-direction: column; gap: 28px; }

  .p4r-slider { display: flex; flex-direction: column; gap: 8px; }
  .p4r-slider-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .p4r-slider-head label { font-size: 16px; }
  .p4r-slider-value { font-family: var(--font-mono); font-size: 16px; font-weight: 600; white-space: nowrap; }
  .p4r-slider input[type='range'] { width: 100%; height: 32px; margin: 0; accent-color: var(--ink-deep); }

  .p4r-ledger { display: flex; flex-direction: column; }
  .p4r-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--rule); font-size: 17px; }
  .p4r-row:last-child { border-bottom: 0; }
  .p4r-row.is-strong { font-weight: 700; }
  .p4r-row-val { font-family: var(--font-mono); font-size: 18px; font-weight: 600; white-space: nowrap; }

  .p4r-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .p4r-card { background: var(--panel); border-radius: 20px; padding: 20px 16px; display: flex; flex-direction: column; gap: 6px; }
  .p4r-card.is-dark { background: var(--ink-deep); color: #fff; }
  .p4r-card-label { font-size: 13px; color: var(--muted); }
  .p4r-card.is-dark .p4r-card-label { color: var(--muted-on-dark); }
  .p4r-card-value { font-family: var(--font-display); font-size: 32px; font-weight: 900; }

  .p4r-big { display: flex; flex-direction: column; gap: 6px; }
  .p4r-big-value { font-family: var(--font-display); font-size: 64px; font-weight: 900; line-height: 1.05; }
  .p4r-big-label { font-size: 17px; color: var(--soft-on-dark); }
  .p4r-rule { height: 1px; background: var(--line-on-dark); }
  .p4r-months { display: flex; align-items: baseline; gap: 10px; }
  .p4r-months-num { font-family: var(--font-display); font-size: 120px; font-weight: 900; line-height: 0.95; color: var(--highlight); }
  .p4r-months-unit { font-family: var(--font-display); font-size: 26px; font-weight: 900; }
  .p4r-lead { margin: 0; font-size: 19px; line-height: 1.7; }
  .p4r-source { margin: 0; font-family: var(--font-mono); font-size: 12px; color: var(--muted-on-dark); }

  .p4r-changes { display: flex; flex-direction: column; gap: 28px; }
  .p4r-change { display: flex; flex-direction: column; gap: 10px; }
  .p4r-change-head { display: flex; justify-content: space-between; gap: 12px; font-size: 16px; }
  .p4r-change-name { font-weight: 700; }
  .p4r-change-val { font-family: var(--font-mono); white-space: nowrap; }
  .p4r-axis { display: flex; justify-content: space-between; gap: 12px; font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  .p4r-axis span:nth-child(2) { text-align: center; }

  .p4r-sources { display: flex; flex-direction: column; border-top: 1px solid var(--rule); }
  .p4r-source-row { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--rule); font-size: 16px; }
  .p4r-source-state { font-family: var(--font-mono); font-size: 12px; white-space: nowrap; }
  .p4r-source-state.is-muted { color: var(--muted); }
  .p4r-next { border-top: 1px solid var(--rule); }
</style>
