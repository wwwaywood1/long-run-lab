---
// src/views/Part2Roulette.astro
/**
 * 第二部分 · 轮盘拆解。设计稿 preview/Part2-Roulette.dc.html，文案 i18n/source/Part2-Roulette.json。
 * 一个模板同时出中英文：文字一律 t()，站内链接一律 pageHref()。
 * 赔率拆解器（切换押法并重算两条赔率条）留 WIDGET 占位；默认“单号”的条照设计稿静态画出。
 */
import Chapter from '../components/chapter/Chapter.astro';
import Hero from '../components/chapter/Hero.astro';
import Step from '../components/chapter/Step.astro';
import NextChapter from '../components/chapter/NextChapter.astro';
import Predict from '../components/chapter/Predict';
import source from '../../i18n/source/Part2-Roulette.json';
import { pageText } from '../i18n/page';
import { pageHref } from '../i18n/routes';
import type { Locale } from '../i18n/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { t, rich } = pageText(source, locale);
---
<Chapter locale={locale} page="Part2-Roulette" title={t(1)} description={t(12)}>
  <nav class="p2r-nav" aria-label={t(2)}>
    <a href={pageHref(locale, 'Part2-Roulette')} aria-current="page">{t(3)}</a>
    <a href="#">{t(4)}</a>
    <a href="#">{t(5)}</a>
    <a href="#">{t(6)}</a>
    <a href="#">{t(7)}</a>
    <a href="#">{t(8)}</a>
    <a href={pageHref(locale, 'Part2-Scam')}>{t(9)}</a>
  </nav>

  <Hero eyebrow={t(10)} title={t(11)} lede={t(12)} />

  <Step id="s1" n="01" verb={t('common.029')} heading={t(13)}>
    <Predict client:visible locale={locale} label={t('common.030')} options={[t(14), t(15), t(16)]} answer={2} />
  </Step>

  <Step id="s2" n="02" verb={t('common.031')} heading={t(17)}>
    {/* WIDGET PayoutBreakdown：输入 = 押法（单号/五号注/一打/红黑，默认单号）；输出 = 公平赔率/实际赔率两条、黑色少付比例、下方 5.26% 文案 */}
    <div class="p2r-breakdown" data-widget="PayoutBreakdown">
      <div role="group" aria-label={t(18)} class="p2r-seg">
        <button type="button" aria-pressed="true">{t(19)}</button>
        <button type="button" aria-pressed="false">{t(20)}</button>
        <button type="button" aria-pressed="false">{t(21)}</button>
        <button type="button" aria-pressed="false">{t(22)}</button>
      </div>

      <div class="p2r-bars">
        <div class="p2r-bar-block">
          <div class="p2r-bar-head"><span>{t(23)}</span><span class="p2r-bar-value">{t(24)}</span></div>
          <div class="p2r-bar-fair"></div>
        </div>
        <div class="p2r-bar-block">
          <div class="p2r-bar-head"><span>{t(25)}</span><span class="p2r-bar-value">{t(26)}</span></div>
          <div class="p2r-bar-actual"><span class="p2r-bar-paid"></span><span class="p2r-bar-keep"></span></div>
        </div>
      </div>

      <p class="ch-body" set:html={rich(27, {
        zh: '黑色那一截，就是庄家少付的 2 倍。摊到每一注，正好是 <strong>5.26%</strong>。',
        en: 'The black slice is the 2 the house does not pay back. Spread over every bet, it comes to exactly <strong>5.26%</strong>.',
      })} />
    </div>
  </Step>

  <Step id="s3" n="03" verb={t('common.032')} heading={t(28)} dark>
    <div class="p2r-table">
      <div class="p2r-row"><span class="p2r-row-label">{t(19)}</span><span class="p2r-row-value">5.26%</span></div>
      <div class="p2r-row"><span class="p2r-row-label">{t(29)}</span><span class="p2r-row-value">5.26%</span></div>
      <div class="p2r-row"><span class="p2r-row-label">{t(30)}</span><span class="p2r-row-value">5.26%</span></div>
      <div class="p2r-row"><span class="p2r-row-label">{t(31)}</span><span class="p2r-row-value">5.26%</span></div>
      <div class="p2r-row is-worst"><span class="p2r-row-label loss">{t(20)}</span><span class="p2r-row-value loss">7.89%</span></div>
      <div class="p2r-row"><span class="p2r-row-label">{t(32)}</span><span class="p2r-row-value">5.26%</span></div>
      <div class="p2r-row"><span class="p2r-row-label">{t(21)}</span><span class="p2r-row-value">5.26%</span></div>
      <div class="p2r-row"><span class="p2r-row-label">{t(33)}</span><span class="p2r-row-value">5.26%</span></div>
    </div>
    <p class="p2r-conclusion" set:html={t(34)} />
    <p class="ch-small">{t(35)}</p>
  </Step>

  <Step id="s4" n="04" verb={t(36)} heading={t(37)} afterDark>
    <nav class="p2r-other" aria-label={t(38)}>
      <a href="#"><span class="p2r-other-title">{t(4)}</span><span class="p2r-other-desc">{t(39)}</span></a>
      <a href="#"><span class="p2r-other-title">{t(5)}</span><span class="p2r-other-desc">{t(40)}</span></a>
      <a href="#"><span class="p2r-other-title">{t(6)}</span><span class="p2r-other-desc">{t(41)}</span></a>
      <a href="#"><span class="p2r-other-title">{t(42)}</span><span class="p2r-other-desc">{t(43)}</span></a>
      <a href="#"><span class="p2r-other-title">{t(8)}</span><span class="p2r-other-desc">{t(44)}</span></a>
      <a href="#"><span class="p2r-other-title">{t(45)}</span><span class="p2r-other-desc">{t(46)}</span></a>
    </nav>
  </Step>

  <div class="p2r-next-dark">
    <NextChapter href={pageHref(locale, 'Part2-Scam')} label={t(47)} title={t(48)} />
  </div>
</Chapter>

<style>
/* 机制导航：设计稿横向排、超出裁切；改成可横向滚动，避免英文标签被切掉 */
.p2r-nav { display: flex; gap: 22px; padding: 8px 0 0 var(--gutter); overflow-x: auto; white-space: nowrap; scrollbar-width: none; }
.p2r-nav::-webkit-scrollbar { display: none; }
.p2r-nav a { flex: none; min-height: 44px; display: flex; align-items: center; color: var(--muted); text-decoration: none; font-size: 15px; }
.p2r-nav a[aria-current='page'] { color: var(--ink); font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 8px; }

/* 赔率拆解器的默认状态（WIDGET 占位） */
.p2r-breakdown { display: flex; flex-direction: column; gap: 28px; }
.p2r-seg { display: flex; background: var(--panel); border-radius: 999px; padding: 4px; }
.p2r-seg button { flex: 1; height: 44px; padding: 0 4px; border: 0; border-radius: 999px; background: transparent; color: var(--ink); font-size: 14px; line-height: 1.2; cursor: pointer; }
.p2r-seg button[aria-pressed='true'] { background: var(--ink-deep); color: #fff; font-weight: 700; }
.p2r-bars { display: flex; flex-direction: column; gap: 22px; padding-top: 8px; }
.p2r-bar-block { display: flex; flex-direction: column; gap: 8px; }
.p2r-bar-head { display: flex; justify-content: space-between; gap: 12px; font-size: 16px; }
.p2r-bar-value { flex: none; white-space: nowrap; font-family: var(--font-mono); }
.p2r-bar-fair { height: 14px; border-radius: 7px; background: var(--rule); }
.p2r-bar-actual { display: flex; height: 14px; }
.p2r-bar-paid { width: 94.6%; border-radius: 7px 0 0 7px; background: var(--you); }
.p2r-bar-keep { flex: 1; border-radius: 0 7px 7px 0; background: var(--ink-deep); }

/* 八种押法 */
.p2r-table { display: flex; flex-direction: column; }
.p2r-row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line-on-dark); }
.p2r-row:last-child { border-bottom: 0; }
.p2r-row-label { font-size: 16px; color: var(--soft-on-dark); }
.p2r-row.is-worst .p2r-row-label { font-weight: 700; }
.p2r-row-value { flex: none; font-family: var(--font-display); font-size: 32px; font-weight: 900; line-height: 1.2; }
.p2r-conclusion { margin: 0; font-family: var(--font-display); font-size: 26px; font-weight: 900; line-height: 1.5; }

/* 其他机制 */
.p2r-other { display: flex; flex-direction: column; border-top: 1px solid var(--rule); }
.p2r-other a { min-height: 76px; display: flex; flex-direction: column; justify-content: center; gap: 2px; text-decoration: none; color: var(--ink); border-bottom: 1px solid var(--rule); }
.p2r-other-title { font-family: var(--font-display); font-size: 19px; font-weight: 700; }
.p2r-other-desc { font-size: 14px; line-height: 1.6; color: var(--muted); }

/* 下一节是黑底大链接：NextChapter 本身是白底样式，这里只覆盖颜色 */
.p2r-next-dark { background: var(--ink-deep); }
.p2r-next-dark :global(.next-link) { color: #fff; }
.p2r-next-dark :global(.next-link .eyebrow) { color: var(--muted-on-dark); }
</style>
