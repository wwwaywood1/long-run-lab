---
// src/views/Prologue.astro
/**
 * 序章 · 你来当庄家。设计稿 preview/Prologue.dc.html，文案 i18n/source/Prologue.json。
 * W2：精确二项抽样与预计算精确分位数；默认种子复现设计稿金额。
 */
import Chapter from '../components/chapter/Chapter.astro';
import Hero from '../components/chapter/Hero.astro';
import Step from '../components/chapter/Step.astro';
import Deeper from '../components/chapter/Deeper.astro';
import NextChapter from '../components/chapter/NextChapter.astro';
import Predict from '../components/chapter/Predict';
import source from '../../i18n/source/Prologue.json';
import { pageText } from '../i18n/page';
import { pageHref } from '../i18n/routes';
import type { Locale } from '../i18n/site';
import HouseLedger, { LEDGER_COPY } from '../components/widgets/HouseLedger';
import numbers from '../../data/numbers.json';
import { PROLOGUE_CHANCE, PROLOGUE_COMPARISON, LEDGER } from '../engine/house-ledger';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { t, rich } = pageText(source, locale);
---
<Chapter locale={locale} page="Prologue" title={t(1)} description={t(4)}>
  <Hero eyebrow={t(2)} title={t(3)} lede={t(4)} />

  <Step id="s1" n="01" verb={t('common.029')} heading={t(5)}>
    <Predict client:visible locale={locale} label={t('common.030')} options={[t(6), t(7), t(8)]} answer={2} />
  </Step>

  <Step id="s2" n="02" verb={t('common.031')} heading={t(9)}>
    <HouseLedger client:visible locale={locale} />
  </Step>

  <Step id="s3" n="03" verb={t('common.032')} heading={t(21)}>
    <svg class="ch-figure" viewBox="0 0 318 150" role="img" aria-label={t(22)}>
      <line x1="8" y1="71" x2="310" y2="71" stroke="#9AA0AA" stroke-width="1" stroke-dasharray="4 4" />
      <g fill="none" stroke="#C9CDD3" stroke-width="1.2" stroke-linejoin="round">
        <path d="M8.0 71.0 L20.1 71.0 L32.2 71.0 L44.2 66.8 L56.3 71.0 L68.4 79.4 L80.5 83.6 L92.6 79.4 L104.6 87.8 L116.7 87.8 L128.8 83.6 L140.9 83.6 L153.0 83.6 L165.0 92.0 L177.1 96.2 L189.2 104.6 L201.3 108.8 L213.4 108.8 L225.4 104.6 L237.5 104.6 L249.6 104.6 L261.7 113.0 L273.8 108.8 L285.8 104.6 L297.9 104.6 L310.0 104.6" />
        <path d="M8.0 71.0 L20.1 71.0 L32.2 79.4 L44.2 83.6 L56.3 83.6 L68.4 83.6 L80.5 87.8 L92.6 87.8 L104.6 92.0 L116.7 96.2 L128.8 92.0 L140.9 87.8 L153.0 79.4 L165.0 83.6 L177.1 79.4 L189.2 75.2 L201.3 75.2 L213.4 71.0 L225.4 75.2 L237.5 75.2 L249.6 71.0 L261.7 71.0 L273.8 71.0 L285.8 71.0 L297.9 75.2 L310.0 83.6" />
        <path d="M8.0 71.0 L20.1 66.8 L32.2 62.6 L44.2 62.6 L56.3 66.8 L68.4 71.0 L80.5 75.2 L92.6 75.2 L104.6 75.2 L116.7 75.2 L128.8 66.8 L140.9 66.8 L153.0 71.0 L165.0 79.4 L177.1 79.4 L189.2 83.6 L201.3 79.4 L213.4 79.4 L225.4 79.4 L237.5 75.2 L249.6 71.0 L261.7 71.0 L273.8 75.2 L285.8 83.6 L297.9 87.8 L310.0 83.6" />
        <path d="M8.0 71.0 L20.1 75.2 L32.2 71.0 L44.2 75.2 L56.3 71.0 L68.4 66.8 L80.5 66.8 L92.6 66.8 L104.6 66.8 L116.7 66.8 L128.8 66.8 L140.9 71.0 L153.0 75.2 L165.0 79.4 L177.1 83.6 L189.2 87.8 L201.3 87.8 L213.4 87.8 L225.4 92.0 L237.5 87.8 L249.6 92.0 L261.7 87.8 L273.8 87.8 L285.8 87.8 L297.9 83.6 L310.0 83.6" />
        <path d="M8.0 71.0 L20.1 66.8 L32.2 71.0 L44.2 71.0 L56.3 66.8 L68.4 71.0 L80.5 79.4 L92.6 83.6 L104.6 87.8 L116.7 92.0 L128.8 92.0 L140.9 96.2 L153.0 100.4 L165.0 92.0 L177.1 96.2 L189.2 100.4 L201.3 104.6 L213.4 108.8 L225.4 108.8 L237.5 104.6 L249.6 108.8 L261.7 104.6 L273.8 104.6 L285.8 104.6 L297.9 100.4 L310.0 92.0" />
        <path d="M8.0 71.0 L20.1 66.8 L32.2 66.8 L44.2 62.6 L56.3 62.6 L68.4 62.6 L80.5 66.8 L92.6 62.6 L104.6 62.6 L116.7 58.4 L128.8 66.8 L140.9 62.6 L153.0 66.8 L165.0 66.8 L177.1 66.8 L189.2 71.0 L201.3 66.8 L213.4 58.4 L225.4 66.8 L237.5 71.0 L249.6 79.4 L261.7 83.6 L273.8 79.4 L285.8 83.6 L297.9 79.4 L310.0 79.4" />
        <path d="M8.0 71.0 L20.1 66.8 L32.2 66.8 L44.2 75.2 L56.3 75.2 L68.4 75.2 L80.5 71.0 L92.6 79.4 L104.6 75.2 L116.7 79.4 L128.8 79.4 L140.9 87.8 L153.0 83.6 L165.0 87.8 L177.1 83.6 L189.2 87.8 L201.3 87.8 L213.4 87.8 L225.4 83.6 L237.5 79.4 L249.6 79.4 L261.7 87.8 L273.8 87.8 L285.8 92.0 L297.9 92.0 L310.0 83.6" />
        <path d="M8.0 71.0 L20.1 75.2 L32.2 79.4 L44.2 79.4 L56.3 83.6 L68.4 87.8 L80.5 92.0 L92.6 92.0 L104.6 96.2 L116.7 104.6 L128.8 104.6 L140.9 108.8 L153.0 108.8 L165.0 108.8 L177.1 100.4 L189.2 100.4 L201.3 96.2 L213.4 104.6 L225.4 96.2 L237.5 100.4 L249.6 96.2 L261.7 96.2 L273.8 104.6 L285.8 104.6 L297.9 104.6 L310.0 104.6" />
        <path d="M8.0 71.0 L20.1 75.2 L32.2 75.2 L44.2 75.2 L56.3 75.2 L68.4 83.6 L80.5 83.6 L92.6 83.6 L104.6 87.8 L116.7 92.0 L128.8 92.0 L140.9 87.8 L153.0 87.8 L165.0 87.8 L177.1 83.6 L189.2 83.6 L201.3 83.6 L213.4 79.4 L225.4 71.0 L237.5 75.2 L249.6 66.8 L261.7 71.0 L273.8 75.2 L285.8 75.2 L297.9 79.4 L310.0 75.2" />
      </g>
      <g fill="none" stroke="var(--you)" stroke-width="2" stroke-linejoin="round">
        <path d="M8.0 71.0 L20.1 79.4 L32.2 83.6 L44.2 83.6 L56.3 83.6 L68.4 83.6 L80.5 83.6 L92.6 83.6 L104.6 83.6 L116.7 79.4 L128.8 75.2 L140.9 79.4 L153.0 75.2 L165.0 71.0 L177.1 66.8 L189.2 66.8 L201.3 62.6 L213.4 66.8 L225.4 66.8 L237.5 62.6 L249.6 58.4 L261.7 54.2 L273.8 58.4 L285.8 58.4 L297.9 66.8 L310.0 58.4" />
        <path d="M8.0 71.0 L20.1 62.6 L32.2 58.4 L44.2 54.2 L56.3 50.0 L68.4 45.8 L80.5 41.6 L92.6 41.6 L104.6 37.4 L116.7 37.4 L128.8 41.6 L140.9 33.2 L153.0 33.2 L165.0 41.6 L177.1 41.6 L189.2 41.6 L201.3 37.4 L213.4 41.6 L225.4 45.8 L237.5 45.8 L249.6 45.8 L261.7 45.8 L273.8 45.8 L285.8 45.8 L297.9 50.0 L310.0 50.0" />
        <path d="M8.0 71.0 L20.1 62.6 L32.2 66.8 L44.2 66.8 L56.3 66.8 L68.4 62.6 L80.5 62.6 L92.6 62.6 L104.6 58.4 L116.7 62.6 L128.8 58.4 L140.9 54.2 L153.0 50.0 L165.0 41.6 L177.1 50.0 L189.2 50.0 L201.3 54.2 L213.4 54.2 L225.4 58.4 L237.5 62.6 L249.6 62.6 L261.7 58.4 L273.8 58.4 L285.8 58.4 L297.9 62.6 L310.0 66.8" />
        <path d="M8.0 71.0 L20.1 75.2 L32.2 79.4 L44.2 79.4 L56.3 75.2 L68.4 75.2 L80.5 71.0 L92.6 62.6 L104.6 71.0 L116.7 71.0 L128.8 66.8 L140.9 66.8 L153.0 66.8 L165.0 66.8 L177.1 66.8 L189.2 71.0 L201.3 66.8 L213.4 58.4 L225.4 54.2 L237.5 58.4 L249.6 62.6 L261.7 58.4 L273.8 62.6 L285.8 62.6 L297.9 66.8 L310.0 66.8" />
        <path d="M8.0 71.0 L20.1 66.8 L32.2 71.0 L44.2 71.0 L56.3 71.0 L68.4 66.8 L80.5 66.8 L92.6 66.8 L104.6 66.8 L116.7 66.8 L128.8 66.8 L140.9 71.0 L153.0 71.0 L165.0 75.2 L177.1 75.2 L189.2 71.0 L201.3 71.0 L213.4 66.8 L225.4 66.8 L237.5 62.6 L249.6 58.4 L261.7 50.0 L273.8 50.0 L285.8 54.2 L297.9 58.4 L310.0 58.4" />
      </g>
    </svg>
    <p class="ch-small">{LEDGER_COPY[locale].illustrated}</p>
    <p class="ch-body" set:html={rich(23, {
      zh: `蓝线是赢钱离场的客人。每位客人押 ${LEDGER.rounds} 局，赢钱离场的概率是 <strong>${(numbers.roulette.p_ahead_after_n.value['100'] * 100).toFixed(1)}%</strong>。`,
      en: `The blue lines are the guests who walked out ahead. Each guest bets ${LEDGER.rounds} rounds; the chance of walking out ahead is <strong>${(numbers.roulette.p_ahead_after_n.value['100'] * 100).toFixed(1)}%</strong>.`,
    })} />
    <p class="ch-body ch-muted" set:html={t(24)} />
  </Step>

  <Step id="s3b" n={t(25)} dark heading={t(26)}>
    <p class="pl-prob" aria-label={t(27)}>{PROLOGUE_CHANCE.prefix}<span class="hl">{PROLOGUE_CHANCE.digits}</span></p>
    <p class="pl-zero-note">{t(28)}</p>
    <div class="pl-rule" />
    <p class="ch-statement" set:html={rich(29, {
      zh: `这比你连续 ${LEDGER.lottery_draws} 期<br>都中双色球一等奖，<br>还要难约 <span class="hl">${PROLOGUE_COMPARISON.toLocaleString('en-US')}</span> 倍。`,
      en: `That's about <span class="hl">${PROLOGUE_COMPARISON.toLocaleString('en-US')}</span> times harder<br>than winning the Double Color Ball jackpot<br>${LEDGER.lottery_draws} draws in a row.`,
    })} />
    <p class="pl-zero-note">{t(30)}</p>
  </Step>

  <Step id="s4" n="04" verb={t('common.033')} heading={t(31)} afterDark>
    <div class="pl-months">
      <span class="pl-months-num">{numbers.facts.nevada_sep_2025.consecutive_months}</span>
      <span class="pl-months-unit">{t(32)}</span>
    </div>
    <p class="ch-body" set:html={t(33)} />
    <p class="pl-source">{t(34)}</p>
  </Step>

  <Deeper summary={t(35)}>
    <p class="ch-muted" set:html={t(36)} />
  </Deeper>

  <NextChapter href={pageHref(locale, 'Ch1-EV')} label={t(37)} title={t(38)} />
</Chapter>

<style>
  /* 揭晓：小数点后 61 个零，末尾的 13 用荧光黄标出；长串按设计稿允许任意断行 */
  .pl-prob { margin: 0; font-family: var(--font-mono); font-size: 30px; font-weight: 500; line-height: 1.35; letter-spacing: 0.02em; word-break: break-all; color: #5D636E; }
  .pl-zero-note { margin: 0; font-family: var(--font-mono); font-size: 14px; line-height: 1.8; color: var(--muted-on-dark); }
  .pl-rule { height: 1px; background: #2A2D33; }

  /* 真实的庄家：120px 数字 + 单位 */
  .pl-months { display: flex; align-items: baseline; gap: 10px; }
  .pl-months-num { font-family: var(--font-display); font-size: 120px; font-weight: 900; line-height: 0.95; }
  .pl-months-unit { font-family: var(--font-display); font-size: 26px; font-weight: 900; }
  .pl-source { margin: 0; font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
</style>
