---
// src/views/Casino.astro
/**
 * 赌场大厅。设计稿 preview/Casino.dc.html，文案 i18n/source/Casino.json。
 * W1：优势、速度和庄家计算来自 engine/house 与 numbers.json。
 */
import Chapter from '../components/chapter/Chapter.astro';
import Hero from '../components/chapter/Hero.astro';
import Step from '../components/chapter/Step.astro';
import NextChapter from '../components/chapter/NextChapter.astro';
import source from '../../i18n/source/Casino.json';
import { pageText } from '../i18n/page';
import { pageHref, type PageName } from '../i18n/routes';
import { money, type Locale } from '../i18n/site';
import HouseCalculator from '../components/widgets/HouseCalculator';
import { CASINO_EDGES, CASINO_SPEEDS } from '../engine/house';
import { baccaratNet } from '../engine/baccarat';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { t, rich } = pageText(source, locale);

const pct = (n: number, digits = 0) => `${(100 * n).toFixed(digits)}%`;
const games: {
  page: PageName;
  n: string;
  name: string;
  desc: string;
  edge: string;
  edgeLabel: string;
  badge?: string;
  loss?: boolean;
}[] = [
  { page: 'RouletteLab', n: '01', name: t(4), desc: t(5), edge: pct(CASINO_EDGES.roulette, 2), edgeLabel: t(6) },
  { page: 'SicBo', n: '02', name: t(7), desc: t(8), edge: pct(CASINO_EDGES.sicbo, 2), edgeLabel: t(9) },
  { page: 'Baccarat', n: '03', name: t(10), desc: t(11), edge: pct(CASINO_EDGES.baccarat, 2), edgeLabel: t(12) },
  { page: 'Slots', n: '04', name: t(13), desc: t(14), edge: pct(CASINO_EDGES.slots, 1), edgeLabel: t(15) },
  { page: 'Crash', n: '05', name: t(16), desc: t(17), edge: pct(CASINO_EDGES.crash), edgeLabel: t(18) },
  { page: 'Blackjack', n: '06', name: t(19), desc: t(20), edge: '0.5%', edgeLabel: t(21) },
  { page: 'Lottery', n: '07', name: t(22), desc: t(24), edge: pct(CASINO_EDGES.lottery), edgeLabel: t(25), badge: t(23), loss: true },
  { page: 'Scratch', n: '08', name: t(26), desc: t(27), edge: pct(CASINO_EDGES.scratch), edgeLabel: t(28), badge: t(23), loss: true },
  { page: 'Gacha', n: '09', name: t(29), desc: t(30), edge: t(31), edgeLabel: t(32), loss: true },
  { page: 'Sports', n: '10', name: t(33), desc: t(34), edge: pct(CASINO_EDGES.sports), edgeLabel: t(35), badge: t(23) },
];

const zeros = [
  { name: t(4), kind: t(38), zero: t(39) },
  { name: t(7), kind: t(40), zero: t(41) },
  { name: t(16), kind: t(42), zero: t(43) },
  { name: t(10), kind: t(44), zero: pct(1 - baccaratNet('B', 'B')) },
  { name: t(19), kind: t(98), zero: t(46) },
  { name: t(13), kind: t(47), zero: pct(CASINO_EDGES.slots, 1) },
  { name: t(26), kind: t(48), zero: pct(CASINO_EDGES.scratch) },
  { name: t(22), kind: t(48), zero: pct(CASINO_EDGES.lottery) },
  { name: t(33), kind: t(49), zero: t(50) },
  { name: t(51), kind: t(52), zero: pct(CASINO_EDGES.gacha) },
];

const speeds = CASINO_SPEEDS.map((speed, i) => ({
  label: t(57 + i * 2), value: money(speed.displayLoss, locale, false),
  width: `${speed.width}%`, strong: speed.id === 'slots',
}));

---

<Chapter locale={locale} page="Casino" title={t('common.004')} description={t(2)} footerPage="Home" footerLabel={t(84)}>
  <Hero eyebrow={t('common.004')} title={t(1)} lede={t(2)} />

  <nav class="cas-games" aria-label={t(3)}>
    {games.map((g) => (
      <a class="cas-game" href={pageHref(locale, g.page)}>
        <span class="cas-num">{g.n}</span>
        <span class="cas-game-text">
          <span class="cas-game-name">{g.badge ? `${g.name} ` : g.name}{g.badge && <span class="cas-badge">{g.badge}</span>}</span>
          <span class="cas-game-desc">{g.desc}</span>
        </span>
        <span class="cas-game-edge">
          <span class:list={['cas-edge', g.loss && 'is-loss']}>{g.edge}</span>
          <span class="cas-edge-label">{g.edgeLabel}</span>
        </span>
      </a>
    ))}
    <p class="cas-note">{t(36)}</p>
  </nav>

  <Step id="zero" heading={t(37)} dark>
    <div class="cas-zeros">
      {zeros.map((z) => (
        <div class="cas-zero-row">
          <span class="cas-zero-name">{z.name}</span>
          <span class="cas-zero-kind">{z.kind}</span>
          <span class="cas-zero-val">{z.zero}</span>
        </div>
      ))}
    </div>
    <p class="cas-statement" set:html={rich(53, {
      zh: '庄家不需要赢下每一局。<br>它只要在每一局里，<br>留一小块<span class="hl">谁也赢不了</span>的地方。',
      en: "The house doesn't need to win every round.<br>It only has to keep, in each round,<br>a small piece <span class=\"hl\">no one can win</span>.",
    })} />
  </Step>

  <Step id="speed" heading={t(99)} afterDark>
    <p class="cas-formula" set:html={t(55)} />
    <div class="cas-speeds">
      <span class="cas-speed-caption">{t(56)}</span>
      {speeds.map((s) => (
        <div class="cas-speed">
          <div class:list={['cas-speed-head', s.strong && 'is-strong']}>
            <span>{s.label}</span>
            <span class="cas-speed-val">{s.value}</span>
          </div>
          <div class="cas-bar"><div class="cas-bar-fill" style={`width: ${s.width}`}></div></div>
        </div>
      ))}
    </div>
    <p class="cas-statement is-small" set:html={rich(69, {
      zh: '同样每注 10 元，<br>老虎机每小时输的，<br>是二十一点的 <span class="cas-mark">约 150 倍</span>。',
      en: 'Same $10 a bet.<br>In an hour, you lose<br><span class="cas-mark">about 150 times</span> as much on a slot machine as at blackjack.',
    })} />
    <p class="ch-small">{t(70)}</p>
  </Step>

  <section aria-labelledby="house-h" class="ch-step cas-house">
    <div class="ch-label"><span class="verb">{t(71)}</span></div>
    <h2 id="house-h" class="ch-h2" set:html={t(72)} />
    <HouseCalculator client:visible locale={locale} />
    <p class="ch-body ch-muted cas-close">{t(81)}</p>
  </section>

  <NextChapter href={pageHref(locale, 'RouletteLab')} label={t(82)} title={t(83)} />
</Chapter>

<style>
  /* 设计稿本页页首只留 72px 底边距（通用样式是 120px）。 */
  :global(.ch-hero) { padding-bottom: 72px; }

  .cas-games { margin: 0 var(--gutter) var(--step); display: flex; flex-direction: column; border-top: 1px solid var(--rule); }
  .cas-game { display: grid; grid-template-columns: 28px 1fr auto; gap: 16px; align-items: baseline; padding: 22px 0; border-bottom: 1px solid var(--rule); text-decoration: none; color: var(--ink); }
  .cas-num { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  .cas-game-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .cas-game-name { font-family: var(--font-display); font-size: 24px; font-weight: 900; }
  .cas-game-desc { font-size: 14px; color: var(--muted); }
  .cas-badge { display: inline-flex; align-items: center; height: 20px; padding: 0 8px; margin-left: 8px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--ink); vertical-align: 4px; font-family: var(--font-body); font-size: 11px; font-weight: 700; }
  .cas-game-edge { align-self: center; display: flex; flex-direction: column; align-items: flex-end; gap: 2px; text-align: right; }
  .cas-edge { font-family: var(--font-mono); font-size: 17px; font-weight: 600; white-space: nowrap; }
  .cas-edge.is-loss { color: var(--loss); }
  .cas-edge-label { font-size: 11px; color: var(--muted); }
  .cas-note { margin: 0; padding-top: 20px; font-size: 13px; line-height: 1.8; color: var(--muted); }

  .cas-zeros { display: flex; flex-direction: column; border-top: 1px solid var(--line-on-dark); }
  .cas-zero-row { min-height: 60px; display: grid; grid-template-columns: 88px 1fr auto; gap: 12px; align-items: center; border-bottom: 1px solid var(--line-on-dark); }
  .cas-zero-name { font-size: 15px; color: var(--muted-on-dark); }
  .cas-zero-kind { font-size: 17px; font-weight: 700; }
  .cas-zero-val { font-family: var(--font-mono); font-size: 14px; color: var(--highlight); white-space: nowrap; }
  .cas-statement { margin: 0; font-family: var(--font-display); font-size: 28px; font-weight: 900; line-height: 1.5; }
  .cas-statement.is-small { font-size: 26px; }
  :global(.cas-mark) { background: var(--highlight); color: var(--ink); padding: 0 4px; }

  .cas-formula { margin: 0; font-family: var(--font-mono); font-size: 14px; line-height: 1.8; background: var(--panel); border-radius: 12px; padding: 14px 16px; }
  .cas-speeds { display: flex; flex-direction: column; gap: 20px; }
  .cas-speed-caption { font-size: 14px; color: var(--muted); }
  .cas-speed { display: flex; flex-direction: column; gap: 8px; }
  .cas-close { font-size: 15px; }
  .cas-speed-head { display: flex; justify-content: space-between; gap: 12px; font-size: 15px; }
  .cas-speed-head.is-strong span:first-child { font-weight: 700; }
  .cas-speed-val { font-family: var(--font-mono); font-weight: 600; white-space: nowrap; }
  .cas-speed-head.is-strong .cas-speed-val { font-weight: 700; }
  .cas-bar { height: 8px; border-radius: 4px; background: var(--panel); }
  .cas-bar-fill { height: 8px; border-radius: 4px; background: var(--loss); min-width: 4px; }

  .cas-house { gap: 24px; }

  /* 设计稿这里的“下一章”只留 24px 上边距，通用样式是 96px。 */
  :global(.ch-next) { padding-top: 24px; }
</style>
