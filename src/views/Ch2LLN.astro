  <Step id="s3" n="03" verb={t('common.032')} heading={t(18)} dark>
    <div class="p2lln-people" aria-hidden="true">
      {people.map((kind) => (
        <span class:list={['p2lln-person', `is-${kind}`]}>
          <span class="p2lln-head"></span>
          <span class="p2lln-body"></span>
        </span>
      ))}
    </div>

    <div class="p2lln-big-line">
      <span class="p2lln-big">4.5</span>
      <span class="p2lln-big-label">{t(19)}</span>
    </div>
    <p class="p2lln-lost loss">{t(20)}</p>
    <p class="p2lln-guess">{t(21)}</p>

    <div class="p2lln-rule"></div>

    <div class="p2lln-bars">
      <span class="p2lln-bars-title">{t(22)}</span>
      <div class="p2lln-bar-row"><span class="p2lln-bar-label">{t(23)}</span><span class="p2lln-bar-track"><span class="p2lln-bar-fill" style="width:94.7%"></span></span><span class="p2lln-bar-value">47.4</span></div>
      <div class="p2lln-bar-row"><span class="p2lln-bar-label">{t(24)}</span><span class="p2lln-bar-track"><span class="p2lln-bar-fill" style="width:62.8%"></span></span><span class="p2lln-bar-value">31.4</span></div>
      <div class="p2lln-bar-row"><span class="p2lln-bar-label">{t(25)}</span><span class="p2lln-bar-track"><span class="p2lln-bar-fill" style="width:53%"></span></span><span class="p2lln-bar-value">26.5</span></div>
      <div class="p2lln-bar-row"><span class="p2lln-bar-label">{t(26)}</span><span class="p2lln-bar-track"><span class="p2lln-bar-fill" style="width:9%"></span></span><span class="p2lln-bar-value">4.5</span></div>
      <div class="p2lln-bar-row"><span class="p2lln-bar-label">{t(27)}</span><span class="p2lln-bar-track"><span class="p2lln-bar-fill is-dot"></span></span><span class="p2lln-bar-value">≈ 0</span></div>
    </div>

    <p class="p2lln-statement" set:html={t(28)} />
    <p class="ch-small">{t(29)}</p>
  </Step>

  <Step id="s4" n="04" verb={t('common.033')} heading={t(30)} afterDark>
    <div class="p2lln-rate">
      <div class="p2lln-rate-head"><span>{t(31)}</span><span>8.8% → 8.0%</span></div>
