  <Deeper summary={t(36)}>
    <p class="ch-muted">{t(37)}</p>
  </Deeper>

  <NextChapter href={pageHref(locale, 'Ch3-Ruin')} label={t(38)} title={t(39)} />
</Chapter>

<style>
/* 资金曲线模拟的默认状态（WIDGET 占位）：分段控件 + 图 + 按钮 */
.p2lln-sim { display: flex; flex-direction: column; gap: 28px; }
