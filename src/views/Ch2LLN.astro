    </div>
    <div class="p2lln-rate">
      <div class="p2lln-rate-head"><span>{t(32)}</span><span>17.10% → 8.49%</span></div>
      <svg class="ch-figure" viewBox="0 0 342 20" aria-hidden="true"><line x1="0" y1="10" x2="342" y2="10" stroke="var(--rule)" stroke-width="2" /><line x1="161.3" y1="10" x2="324.9" y2="10" stroke="var(--ink-deep)" stroke-width="2" /><circle cx="324.9" cy="10" r="6" fill="#FFFFFF" stroke="var(--ink-deep)" stroke-width="2" /><circle cx="161.3" cy="10" r="6" fill="var(--ink-deep)" /></svg>
