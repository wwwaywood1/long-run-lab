---
// src/views/Ch2LLN.astro
/**
 * 第 2 章 · 大数定律。设计稿 preview/Ch2-LLN.dc.html，文案 i18n/source/Ch2-LLN.json。
 * 一个模板同时出中英文：文字一律 t()，站内链接一律 pageHref()。
 * 资金曲线与精确逐时点分位数来自 engine/lln。
 */
import Chapter from '../components/chapter/Chapter.astro';
import Hero from '../components/chapter/Hero.astro';
import Step from '../components/chapter/Step.astro';
import Deeper from '../components/chapter/Deeper.astro';
import NextChapter from '../components/chapter/NextChapter.astro';
import Predict from '../components/chapter/Predict';
import Ch2Sim from '../components/widgets/Ch2Sim';
import { aheadPerHundred, rareAheadMillions, peopleShares } from '../engine/lln';
import numbers from '../../data/numbers.json';
import source from '../../i18n/source/Ch2-LLN.json';
import { pageText } from '../i18n/page';
import { pageHref } from '../i18n/routes';
import type { Locale } from '../i18n/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { t } = pageText(source, locale);

const people = peopleShares();
const hold = numbers.facts.nevada_sep_2025;
const slots = hold.strip_slots_hold.value;
const baccarat = hold.strip_baccarat_hold.value;
const pct = (n: number, digits: number) => (100 * n).toFixed(digits) + '%';
const holdX = (n: number) => n / 0.18 * 342;
const barRounds = [1, 10, 100, 1000, 10000];
// Replace numeric tokens only, never localized phrases. Copy tests check both original sources.
const rareCopy = t(28).replace(locale === 'zh' ? /1500/ : /15/, String(locale === 'zh' ? rareAheadMillions * 100 : rareAheadMillions));
---
<Chapter locale={locale} page="Ch2-LLN" title={t(1)} description={t(4)}>
  <Hero eyebrow={t(2)} title={t(3)} lede={t(4)} />

  <Step id="s1" n="01" verb={t('common.029')} heading={t(5)}>
    <Predict client:visible locale={locale} label={t('common.030')} options={[t(6), t(7), t(8)]} answer={2} />
  </Step>

  <Step id="s2" n="02" verb={t('common.031')} heading={t(9)}>
    <Ch2Sim client:visible locale={locale} />
  </Step>

  <Step id="s3" n="03" verb={t('common.032')} heading={t(18)} dark>
    <div class="p2lln-people" aria-hidden="true">
      {people.map((share) => (
        <span class="p2lln-person" style={`--ahead: ${share * 100}%`}>
          <span class="p2lln-head"></span>
          <span class="p2lln-body"></span>
        </span>
      ))}
    </div>

    <div class="p2lln-big-line">
      <span class="p2lln-big">{aheadPerHundred(1000).toFixed(1)}</span>
      <span class="p2lln-big-label">{t(19)}</span>
    </div>
    <p class="p2lln-lost loss">{t(20).replace(/95\.5/, (100 - aheadPerHundred(1000)).toFixed(1))}</p>
    <p class="p2lln-guess">{t(21)}</p>

    <div class="p2lln-rule"></div>

    <div class="p2lln-bars">
      <span class="p2lln-bars-title">{t(22)}</span>
      {barRounds.map((n, i) => <div class="p2lln-bar-row"><span class="p2lln-bar-label">{t(23 + i)}</span><span class="p2lln-bar-track"><span class="p2lln-bar-fill" style={`width:${aheadPerHundred(n) * 2}%;min-width:2px`}></span></span><span class="p2lln-bar-value">{aheadPerHundred(n) < 0.05 ? '≈ 0' : aheadPerHundred(n).toFixed(1)}</span></div>)}
    </div>

    <p class="p2lln-statement" set:html={rareCopy} />
    <p class="ch-small">{t(29)}</p>
  </Step>

  <Step id="s4" n="04" verb={t('common.033')} heading={t(30)} afterDark>
    <div class="p2lln-rate">
      <div class="p2lln-rate-head"><span>{t(31)}</span><span>{slots.map(n => pct(n, 1)).join(' → ')}</span></div>
      <svg class="ch-figure" viewBox="0 0 342 20" aria-hidden="true"><line x1="0" y1="10" x2="342" y2="10" stroke="var(--rule)" stroke-width="2" /><line x1={holdX(slots[1])} y1="10" x2={holdX(slots[0])} y2="10" stroke="var(--ink-deep)" stroke-width="2" /><circle cx={holdX(slots[0])} cy="10" r="6" fill="#FFFFFF" stroke="var(--ink-deep)" stroke-width="2" /><circle cx={holdX(slots[1])} cy="10" r="6" fill="var(--ink-deep)" /></svg>
    </div>
    <div class="p2lln-rate">
      <div class="p2lln-rate-head"><span>{t(32)}</span><span>{baccarat.map(n => pct(n, 2)).join(' → ')}</span></div>
      <svg class="ch-figure" viewBox="0 0 342 20" aria-hidden="true"><line x1="0" y1="10" x2="342" y2="10" stroke="var(--rule)" stroke-width="2" /><line x1={holdX(baccarat[1])} y1="10" x2={holdX(baccarat[0])} y2="10" stroke="var(--ink-deep)" stroke-width="2" /><circle cx={holdX(baccarat[0])} cy="10" r="6" fill="#FFFFFF" stroke="var(--ink-deep)" stroke-width="2" /><circle cx={holdX(baccarat[1])} cy="10" r="6" fill="var(--ink-deep)" /></svg>
    </div>
    <div class="p2lln-axis"><span>0%</span><span>{t(33)}</span><span>18%</span></div>
    <p class="p2lln-caption">{t(34)}</p>
    <p class="p2lln-source">{t(35)}</p>
  </Step>

  <Deeper summary={t(36)}>
    <p class="ch-muted">{t(37)}</p>
  </Deeper>

  <NextChapter href={pageHref(locale, 'Ch3-Ruin')} label={t(38)} title={t(39)} />
</Chapter>

<style>
/* 100 个人：4.5 个还赚钱 */
.p2lln-people { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); row-gap: 14px; }
.p2lln-person { display: flex; flex-direction: column; align-items: center; gap: 2px; }
.p2lln-head { width: 11px; height: 11px; border-radius: 999px; }
.p2lln-body { width: 20px; height: 16px; border-radius: 10px 10px 3px 3px; }
.p2lln-head, .p2lln-body { background: linear-gradient(90deg, #fff var(--ahead), var(--loss-on-dark) var(--ahead)); }

.p2lln-big-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; }
.p2lln-big { font-family: var(--font-display); font-size: 120px; font-weight: 900; line-height: 0.95; }
.p2lln-big-label { font-size: 20px; font-weight: 700; }
.p2lln-lost { margin: 0; font-size: 20px; font-weight: 700; }
.p2lln-guess { margin: 0; font-size: 15px; color: var(--muted-on-dark); }
.p2lln-rule { height: 1px; background: var(--line-on-dark); }

.p2lln-bars { display: flex; flex-direction: column; gap: 14px; }
.p2lln-bars-title { font-size: 15px; color: var(--soft-on-dark); }
.p2lln-bar-row { display: grid; grid-template-columns: minmax(76px, auto) 1fr 64px; gap: 10px; align-items: center; font-family: var(--font-mono); font-size: 14px; }
.p2lln-bar-label { color: var(--muted-on-dark); }
.p2lln-bar-track { display: flex; align-items: center; height: 4px; }
.p2lln-bar-fill { display: block; height: 4px; border-radius: 2px; background: #FFFFFF; }
.p2lln-bar-fill.is-dot { width: 4px; }
.p2lln-bar-value { text-align: right; }
.p2lln-statement { margin: 0; font-family: var(--font-display); font-size: 26px; font-weight: 900; line-height: 1.5; }

/* 庄家赢率：两条细线图 */
.p2lln-rate { display: flex; flex-direction: column; gap: 10px; }
.p2lln-rate-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-size: 16px; }
.p2lln-rate-head span:first-child { font-weight: 700; }
.p2lln-rate-head span:last-child { flex: none; white-space: nowrap; font-family: var(--font-mono); }
.p2lln-axis { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
.p2lln-caption { margin: 0; font-size: 15px; line-height: 1.8; color: var(--muted); }
.p2lln-source { margin: 0; font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
</style>
